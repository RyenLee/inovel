{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    }
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "longDescription": "iNovel is a desktop application designed for novel authors, providing project management, chapter editing, worldbuilding features, and more.",
    "resources": [
      "resources/names.json",
      "resources/builtin_templates.json",
      "resources/default_config.toml"
    ],
    "shortDescription": "Novel writing and management tool",
    "targets": ["msi", "nsis", "dmg", "app", "deb", "appimage"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "identifier": "com.ryenl.inovel",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ryenl/inovel/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBMjNGQjdGRUI2MjdCNjEKUldUSjhDQUFBQT09Cg==",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "productName": "iNovel",
  "version": "1.1.1"
}
